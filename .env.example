# Copy this file to .env and run commands with `uv run --env-file .env ...`.
# .env is git-ignored. Never commit a real key.

# Cohere API key (https://dashboard.cohere.com).
# Paste it without quotes: CO_API_KEY=abc123yourkey
CO_API_KEY=

# Optional settings, shown with their defaults. Uncomment a line to change it.
# KA_CHAT_MODEL=command-a-plus-05-2026
# KA_EMBED_MODEL=embed-v5.0-fast
# KA_RERANK_MODEL=rerank-v5.0-pro
# KA_LLM_TEMPERATURE=0
# KA_LLM_TIMEOUT_SECONDS=60
# KA_LLM_MAX_RETRIES=2
# Reasoning for chat: enabled or disabled. Unset keeps the model's default (enabled for Command A+).
# KA_CHAT_THINKING=
# KA_EVENT_LOG=runtime/logs/llm-events.jsonl
